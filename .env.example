# Local SQLite file (default if unset)
DATABASE_URL=file:./data/coachbase.db

# For Turso (production / Vercel), use your remote URL + token:
# DATABASE_URL=libsql://your-db-name-org.turso.io
# DATABASE_AUTH_TOKEN=your-token

# Coach password gate (required to lock the app down)
# Generate AUTH_SECRET with: openssl rand -hex 32
AUTH_PASSWORD=change-me
AUTH_SECRET=
